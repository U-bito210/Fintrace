# FinTrace-CN optional integrations. Offline demo and tests need no secrets.
TUSHARE_TOKEN=

# Only required for real (non-dry-run) Agent evaluation.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Alibaba Cloud Model Studio / 百炼 (DashScope), OpenAI-compatible endpoint.
# Key: console API key (sk-...).  Endpoint: the mainland-China compatible-mode
# URL.  Models: qwen3-max / qwen-plus / qwen-flash.
# NOTE: 百炼 bills in CNY and this project's cost ledger is USD, so these models
# are registered UNPRICED — the Agent runs fine, but any cost figure for them is
# reported as unknown rather than converted at a hand-picked rate.  Pointing
# DEEPSEEK_BASE_URL here has the same effect: the registered USD price is voided,
# and a --max-cost-usd ceiling is refused rather than silently never firing.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional writable cache root. Defaults to ./data/.cache.
FINTRACE_CACHE_DIR=
